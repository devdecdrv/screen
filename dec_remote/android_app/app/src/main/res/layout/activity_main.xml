<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="dec Remote"
            android:textColor="#58A6FF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Phone → Claude MCP"
            android:textColor="#8B949E"
            android:textSize="14sp"
            android:layout_marginBottom="32dp"/>

        <!-- Bot Token -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Telegram Bot Token"
            android:textColor="#C9D1D9"
            android:textSize="13sp"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/etBotToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="7123456789:AAGxyz..."
            android:textColor="#C9D1D9"
            android:textColorHint="#484F58"
            android:background="#161B22"
            android:padding="12dp"
            android:inputType="text"
            android:layout_marginBottom="16dp"/>

        <!-- Chat ID -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Telegram Chat ID"
            android:textColor="#C9D1D9"
            android:textSize="13sp"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/etChatId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="123456789"
            android:textColor="#C9D1D9"
            android:textColorHint="#484F58"
            android:background="#161B22"
            android:padding="12dp"
            android:inputType="number"
            android:layout_marginBottom="16dp"/>

        <!-- Worker URL -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cloudflare Worker URL"
            android:textColor="#C9D1D9"
            android:textSize="13sp"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/etWorkerUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://dec-remote.yourname.workers.dev"
            android:textColor="#C9D1D9"
            android:textColorHint="#484F58"
            android:background="#161B22"
            android:padding="12dp"
            android:inputType="textUri"
            android:layout_marginBottom="16dp"/>

        <!-- Auth Token -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Auth Token (worker.js में same डालो)"
            android:textColor="#C9D1D9"
            android:textSize="13sp"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/etAuthToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="dec_secret_xyz123"
            android:textColor="#C9D1D9"
            android:textColorHint="#484F58"
            android:background="#161B22"
            android:padding="12dp"
            android:inputType="text"
            android:layout_marginBottom="24dp"/>

        <!-- Cloudflare Guide Button -->
        <Button
            android:id="@+id/btnCloudflareGuide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="☁️ Cloudflare कैसे Setup करें?"
            android:textColor="#58A6FF"
            android:backgroundTint="#161B22"
            android:layout_marginBottom="12dp"/>

        <!-- Start Button -->
        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="▶ START"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#238636"
            android:layout_marginBottom="12dp"/>

        <!-- Stop Button -->
        <Button
            android:id="@+id/btnStop"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="⛔ STOP"
            android:textColor="#FFFFFF"
            android:backgroundTint="#B62324"
            android:layout_marginBottom="24dp"/>

        <!-- Status -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⏸ Not running"
            android:textColor="#8B949E"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginBottom="32dp"/>

    </LinearLayout>
</ScrollView>
